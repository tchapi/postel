# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###


###> app ###
# Comma-separated list of proxies allowed to authenticate requests through
# the Remote-User / Remote-Email headers (Authelia forward-auth through Traefik).
TRUSTED_PROXIES=

# IMAP server, reached with a Dovecot master user so Postel never sees
# the user's own password. See docs/architecture.md.
IMAP_HOST=mail
IMAP_PORT=143
# false, ssl or tls (STARTTLS)
IMAP_ENCRYPTION=false
IMAP_VALIDATE_CERT=true
IMAP_MASTER_USER=webmail
IMAP_MASTER_PASSWORD=
# Which forward-auth header is the IMAP login: email (Remote-Email) or username (Remote-User)
IMAP_LOGIN_ATTRIBUTE=email

# SMTP submission, authenticated with the same master user
SMTP_HOST=mail
SMTP_PORT=587
# false, ssl or tls (STARTTLS)
SMTP_ENCRYPTION=tls
SMTP_VALIDATE_CERT=true

# Davis, for contacts autocomplete, reached with an app key so Postel
# never sees the user's Davis password. Empty URL turns contacts off.
# e.g. https://dav.example.com/dav/
DAVIS_URL=
DAVIS_APP_ID=
DAVIS_APP_SECRET=
# Which forward-auth header is the Davis login: username (Remote-User) or email (Remote-Email)
DAVIS_LOGIN_ATTRIBUTE=username

# Where "Sign out" goes, e.g. the Authelia logout page. Empty reloads the page.
LOGOUT_URL=

# Where uploads and the settings database live
APP_DATA_DIR=%kernel.project_dir%/var/data
###< app ###

###> doctrine/doctrine-bundle ###
# Settings live in a SQLite file under APP_DATA_DIR. Any Doctrine DSN works.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/postel.db"
###< doctrine/doctrine-bundle ###
